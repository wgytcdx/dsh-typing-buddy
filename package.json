{
  "name": "dsh-typing-buddy",
  "version": "0.2.0",
  "description": "DSH 界面悬浮头像，跟随会话和工具活动，支持静音视频、外观设置和形象预览激活",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wgytcdx/dsh-typing-buddy.git"
  },
  "homepage": "https://github.com/wgytcdx/dsh-typing-buddy#readme",
  "bugs": {
    "url": "https://github.com/wgytcdx/dsh-typing-buddy/issues"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "widget",
    "typing"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./lib/index.js": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "!lib/index.full.js.bak",
    "assets",
    "src",
    "scripts",
    "docs",
    "icon.svg",
    "screenshots.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "test"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js",
    "test": "node --test test/*.test.mjs && node test/host-smoke.mjs",
    "test:browser": "node test/browser.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-session-controller"
      ],
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "playwright": "^1.56.1"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
